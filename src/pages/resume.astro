---
import "../styles/global.css";

const title = "Sdu Gumede — Senior Consultant & Software Engineer";
const description =
  "Senior Consultant and software engineer with 7+ years of experience delivering production systems across backend, web, mobile, cloud and integrations.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f5f7" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body class="resume-body">
    <nav class="resume-actions" aria-label="Résumé actions">
      <a href="/">Back to portfolio</a>
      <button type="button" data-print-resume>Print / save PDF</button>
    </nav>

    <main class="resume-document">
      <section class="sheet sheet--first" aria-label="Résumé page 1 of 2">
        <header class="identity">
          <div class="identity__primary">
            <p class="kicker">Senior Consultant · Senior Software Engineer</p>
            <h1>Sdu Gumede</h1>
          </div>

          <address class="contact" aria-label="Contact details">
            <span>Johannesburg, South Africa</span>
            <a href="mailto:gumedesduduzo@gmail.com">gumedesduduzo@gmail.com</a>
            <a href="https://sduu.dev">sduu.dev</a>
            <a href="https://github.com/sduduzog">github.com/sduduzog</a>
          </address>
        </header>

        <section class="opening" aria-labelledby="profile-title">
          <div class="summary">
            <p class="section-label" id="profile-title">Profile</p>
            <p>
              Senior Consultant and software engineer with 6+ years of hands-on
              engineering experience delivering and operating production systems
              across retail, financial services and insurance. Owns complex client
              problems from discovery and architecture through implementation, release
              and measurable production outcomes. Works across mobile, backend and web
              systems, choosing pragmatic designs, improving engineering standards and
              remaining accountable for how software behaves in production.
            </p>
          </div>
        </section>

        <section class="experience" aria-labelledby="experience-title">
          <div class="section-title-row">
            <h2 id="experience-title">Professional experience</h2>
            <p>7+ years · South Africa and UK client teams</p>
          </div>

          <article class="employer">
            <header class="employer__header">
              <div>
                <h3>Daemon</h3>
              </div>
              <p class="role-dates">
                <span>Senior Consultant · Dec 2023–present</span>
              </p>
            </header>

            <p class="employer__context">
              Works directly with UK retail, fintech and insurance clients, leading
              technical direction while remaining responsible for implementation,
              production outcomes and mentoring.
            </p>

            <div class="engagements">
              <article class="engagement">
                <header class="engagement__header">
                  <div>
                    <h4>Sainsbury’s SmartShop</h4>
                    <p>Senior Software Engineer</p>
                  </div>
                  <time datetime="2026-07">Jul 2026–present</time>
                </header>
                <ul>
                  <li>
                    Redesigned SmartShop’s Android connectivity handling around modern
                    network callbacks and a single source of truth, eliminating false
                    positives and stabilising handset behaviour; within 24 hours of
                    release, New Relic events fell from approximately 11.4K to 468 and
                    affected handsets from approximately 1.5K to 85.
                  </li>
                  <li>
                    Consolidated fragmented handset-readiness events across application
                    versions into one New Relic event with contextual attributes,
                    simplifying dashboard reporting and enabling aggregate analysis
                    without losing diagnostic detail.
                  </li>
                  <li>
                    Resolved a production defect in SmartShop’s handset docking and
                    session-reset flow by centralising logout and holding-screen
                    navigation at the application level, eliminating screen-dependent
                    lifecycle races and adding deterministic regression coverage for
                    hardware events.
                  </li>
                  <li>
                    Leads Daemon’s engagement at Sainsbury’s while continuing hands-on
                    engineering, maintaining visibility of delivery progress,
                    dependencies, risks and mitigations across both organisations.
                  </li>
                </ul>
              </article>

              <article class="engagement">
                <header class="engagement__header">
                  <div>
                    <h4>Amazon Just Walk Out</h4>
                    <p>Senior Software Engineer</p>
                  </div>
                  <time>Jan–May 2026</time>
                </header>
                <ul>
                  <li>
                    Replaced a SwiftPOS-only connector with a configurable provider
                    architecture, owning the shared contract as requirements evolved;
                    delivered three completed, validated integrations that expanded
                    point-of-sale options for future merchant onboarding, with Oracle
                    ready for partner certification.
                  </li>
                  <li>
                    Established manual end-to-end testing as part of the team’s delivery
                    process, capturing findings as prioritised defects and creating a
                    repeatable feedback loop that surfaced non-obvious integration bugs
                    for iterative resolution.
                  </li>
                </ul>
              </article>

              <article class="engagement">
                <header class="engagement__header">
                  <div>
                    <h4>AJ Bell</h4>
                    <p>Senior Software Engineer</p>
                  </div>
                  <time>Feb–Nov 2025</time>
                </header>
                <ul>
                  <li>
                    Led the selection and initial production implementation of
                    WorkflowCore for AJ Bell’s benefits case-management platform,
                    defining its distributed AWS architecture, persistence, start and
                    resume APIs, and testable workflow-action patterns; the resulting
                    team platform completed its first payout the same day, with four
                    more paid and 44 cases in final processing.
                  </li>
                  <li>
                    Rebuilt the project’s Playwright test setup around composable
                    builders and isolated data, eliminating flaky tests caused by shared
                    setup, improving CI reliability and making the full suite easier to
                    extend.
                  </li>
                </ul>
              </article>
            </div>
          </article>
        </section>

        <footer class="page-footer">
          <span>sduu.dev/resume</span>
          <span>01 / 02</span>
        </footer>
      </section>

      <section class="sheet" aria-label="Résumé page 2 of 2">
        <header class="continuation-header">
          <div>
            <strong>Sdu Gumede</strong>
            <span>Senior Consultant · Senior Software Engineer</span>
          </div>
          <span>Professional experience, continued</span>
        </header>

        <section class="experience experience--continued" aria-label="Professional experience continued">
          <article class="engagement engagement--standalone">
            <header class="engagement__header">
              <div>
                <h4>Domestic &amp; General</h4>
                <p>Software Engineer</p>
              </div>
              <time>Dec 2023–Nov 2024</time>
            </header>
            <ul>
              <li>
                Centralised duplicated profile and address validation across three
                TypeScript repositories, giving producers and consumers one shared
                contract; the work exposed conflicting address models and prompted the
                business to clarify which properties were required.
              </li>
              <li>
                Secured adoption of Drizzle-authored migrations for production schema
                changes, replacing database introspection; applied and reinforced
                testable Lambda data-access patterns through delivery, code review and
                team guidance as the wider refactor progressed.
              </li>
              <li>
                Introduced a layered testing approach for AWS Lambda services, testing
                handlers against mocked dependencies, service logic independently and
                selected handler-to-service paths, shifting tests from coverage targets
                towards clear behavioural verification.
              </li>
              <li>
                Mentored a junior engineer through pair programming, TDD and
                behaviour-focused testing, improving her independence and ability to
                verify the behaviour changed by her work.
              </li>
            </ul>
          </article>

          <article class="employer employer--secondary">
            <header class="employer__header">
              <div>
                <h3>Codeo</h3>
              </div>
              <p class="role-dates"><span>Mar 2019–Dec 2023</span></p>
            </header>

            <p class="employer__context">
              Worked across Famous Brands and SPAR products, moving from end-to-end
              quality assurance into full-stack delivery spanning mobile, web and .NET
              services.
            </p>

            <div class="codeo-roles">
              <section class="codeo-role" aria-labelledby="codeo-software-engineer">
                <header class="codeo-role__header">
                  <h4 id="codeo-software-engineer">Software Engineer</h4>
                  <time datetime="2020-02">Feb 2020–Dec 2023</time>
                </header>
                <ul class="employer__results">
                  <li>
                    Replaced hard-coded frontend and backend permissions in a multi-brand
                    commerce platform with dynamic role-based access control scoped by
                    store, brand and region, preventing access outside each user’s
                    authorised operational scope.
                  </li>
                  <li>
                    Modernised a legacy AngularJS back-office application by overhauling
                    its build system, introducing Jest and enabling TypeScript, resulting
                    in faster builds, more accessible testing and smoother onboarding.
                  </li>
                  <li>
                    Built and maintained React Native applications for ordering and retail
                    rewards, integrating push notifications, deep links, native modules and
                    analytics while managing Android releases to Google Play.
                  </li>
                  <li>
                    Built reusable .NET sagas and workflows for long-running ordering,
                    campaign, promotion and voucher processes across Yumbi and SPAR,
                    providing shared orchestration without duplicating flow logic between
                    products.
                  </li>
                </ul>
              </section>

              <section class="codeo-role" aria-labelledby="codeo-quality-engineer">
                <header class="codeo-role__header">
                  <h4 id="codeo-quality-engineer">Junior Quality Assurance Engineer</h4>
                  <time datetime="2019-03">Mar 2019–Jan 2020</time>
                </header>
                <ul class="employer__results">
                  <li>
                    Tested customer-facing web and mobile applications for Famous Brands
                    and SPAR Rewards, alongside the Famous Brands management platform and
                    franchisee dashboard; maintained feature and regression cases while
                    helping resolve specification gaps from design through delivery.
                  </li>
                  <li>
                    Introduced automated post-deployment checks into the delivery pipeline,
                    reducing smoke-test time from 30–40 minutes to 5–10 minutes, and began
                    contributing frontend production code before moving into software
                    engineering.
                  </li>
                </ul>
              </section>
            </div>
          </article>
        </section>

        <section class="education-section" aria-labelledby="education-title">
          <div class="section-title-row">
            <h2 id="education-title">Education</h2>
          </div>
          <div class="education-entry">
            <div>
              <h3>Bachelor of Science in Computer Science</h3>
              <p>University of Zululand</p>
            </div>
            <time datetime="2019">2019</time>
          </div>
        </section>

        <section class="projects-section" aria-labelledby="projects-title">
          <div class="section-title-row">
            <h2 id="projects-title">Projects</h2>
          </div>

          <div class="engagements project-list">
            <article class="engagement project">
              <header class="engagement__header">
                <div>
                  <h4>Duun</h4>
                </div>
                <div class="project-meta">
                  <span>29 scoped MCP tools</span>
                  <a href="https://duun.app">duun.app</a>
                </div>
              </header>
              <ul>
                <li>
                  Designed, built and operates a production task-management platform
                  using Elixir, Phoenix, Vue and PostgreSQL. Its permission-scoped MCP
                  server gives AI agents structured access to task search, planning,
                  scheduling and sharing through OAuth and granular read/write scopes.
                  Used Amp, Claude Code, OpenCode with oh-my-opencode and GitHub Copilot
                  across development, backed by automated backend and Playwright tests.
                </li>
              </ul>
            </article>

            <article class="engagement project">
              <header class="engagement__header">
                <div>
                  <h4>Slim Launcher</h4>
                  <p>Open-source Android application</p>
                </div>
                <div class="project-meta">
                  <span>100K+ downloads</span>
                  <a href="https://github.com/sduduzog/slim-launcher">GitHub</a>
                </div>
              </header>
              <ul>
                <li>
                  Published and maintains a Kotlin Android application with 350+ GitHub
                  stars and 500+ commits, demonstrating sustained product ownership,
                  public releases and collaboration with an open-source user community.
                </li>
              </ul>
            </article>
          </div>
        </section>

        <section class="community-section" aria-labelledby="community-title">
          <p class="section-label" id="community-title">Speaking and community</p>
          <ul>
            <li>
              Presented “My Point of Vue” at JoziJS and delivered internal engineering
              sessions that helped teams adopt new frontend, database-migration and
              testing practices.
            </li>
            <li>
              Co-hosted 34 episodes of <a href="https://zatechradio.com">ZATechRadio</a>
              and helps run its South African technology community, hosting conversations
              about engineering careers, workplace practice and the realities of working
              in tech.
            </li>
          </ul>
        </section>

        <footer class="page-footer">
          <span>sduu.dev/resume</span>
          <span>02 / 02</span>
        </footer>
      </section>
    </main>

    <script>
      document
        .querySelector("[data-print-resume]")
        ?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f4f5f7;
    scroll-behavior: smooth;
  }

  :global(.resume-body) {
    --ink: #172033;
    --ink-secondary: rgba(23, 32, 51, 0.72);
    --ink-tertiary: rgba(23, 32, 51, 0.5);
    --rule: #d9dee7;
    --accent: #1d4ed8;
    min-width: 20rem;
    margin: 0;
    padding: 2.5rem 1rem 4rem;
    color: var(--ink);
    background: #f4f5f7;
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  :global(.resume-body ::selection) {
    color: #ffffff;
    background: var(--accent);
  }

  .resume-actions {
    display: flex;
    width: min(210mm, calc(100vw - 2rem));
    min-height: 2.75rem;
    margin: 0 auto 1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .resume-actions a,
  .resume-actions button {
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: var(--ink-secondary);
    background: transparent;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .resume-actions a:hover {
    color: var(--ink);
  }

  .resume-actions button {
    border-color: var(--ink);
    color: #ffffff;
    background: var(--ink);
  }

  .resume-actions a:focus-visible,
  .resume-actions button:focus-visible,
  a:focus-visible {
    outline: 3px solid rgba(29, 78, 216, 0.42);
    outline-offset: 3px;
  }

  .resume-document {
    display: grid;
    gap: 1.5rem;
  }

  .sheet {
    display: flex;
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 14mm 16mm 11mm;
    flex-direction: column;
    background: #ffffff;
    box-shadow: 0 1.5rem 4.5rem rgba(23, 32, 51, 0.1);
  }

  .identity {
    display: grid;
    padding-bottom: 4.5mm;
    grid-template-columns: minmax(0, 1.55fr) minmax(13rem, 0.7fr);
    gap: 9mm;
    align-items: end;
    border-bottom: 3px solid var(--accent);
  }

  .kicker,
  .section-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
    text-transform: none;
  }

  .kicker {
    font-size: 0.7rem;
  }

  .identity h1 {
    margin: 0.12rem 0 0;
    font-size: 2.35rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .contact {
    display: grid;
    gap: 0.18rem;
    justify-items: end;
    color: var(--ink-secondary);
    font-size: 0.64rem;
    font-style: normal;
    line-height: 1.45;
  }

  .contact a,
  .project-meta a,
  .community-section a {
    color: inherit;
    text-decoration-color: rgba(29, 78, 216, 0.5);
    text-decoration-skip-ink: auto;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
    text-underline-position: from-font;
  }

  .opening {
    padding: 4.2mm 0;
    border-bottom: 1px solid var(--rule);
  }

  .summary > p:last-child {
    max-width: 86ch;
    margin: 0.45rem 0 0;
    color: var(--ink-secondary);
    font-size: 0.75rem;
    line-height: 1.52;
    text-wrap: pretty;
  }

  .experience {
    padding-top: 4mm;
  }

  .section-title-row {
    display: flex;
    padding-bottom: 2.5mm;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .section-title-row h2 {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .section-title-row > p {
    margin: 0;
    color: var(--ink-tertiary);
    font-size: 0.58rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .employer {
    padding-top: 3mm;
  }

  .employer__header,
  .engagement__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .employer__header h3,
  .engagement__header h4 {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .employer__header h3 {
    font-size: 0.96rem;
  }

  .employer__header p,
  .engagement__header p {
    margin: 0.08rem 0 0;
    color: var(--ink-secondary);
    font-size: 0.65rem;
    line-height: 1.35;
  }

  .role-dates {
    display: grid;
    gap: 0.1rem;
    justify-items: end;
    color: var(--ink) !important;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .employer__context {
    max-width: 94ch;
    margin: 0.5rem 0 0;
    color: var(--ink-secondary);
    font-size: 0.67rem;
    line-height: 1.48;
    text-wrap: pretty;
  }

  .engagements {
    display: grid;
    margin-top: 2.6mm;
    border-top: 1px solid var(--rule);
  }

  .engagement {
    padding: 2.9mm 0 2.6mm;
    break-inside: avoid;
  }

  .engagement + .engagement {
    border-top: 1px solid var(--rule);
  }

  .engagement__header h4 {
    font-size: 0.78rem;
  }

  .engagement__header time {
    flex: none;
    color: var(--ink);
    font-size: 0.57rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    white-space: nowrap;
  }

  .engagement ul,
  .employer__results,
  .community-section ul {
    display: grid;
    margin: 0.42rem 0 0;
    padding: 0;
    gap: 0.24rem;
    list-style: none;
  }

  .engagement li,
  .employer__results li,
  .community-section li {
    position: relative;
    margin: 0;
    padding-left: 0.85rem;
    color: var(--ink-secondary);
    font-size: 0.67rem;
    line-height: 1.42;
    text-wrap: pretty;
  }

  .engagement li::before,
  .employer__results li::before,
  .community-section li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.22rem;
    height: 0.22rem;
    border-radius: 50%;
    background: var(--ink-tertiary);
    content: "";
  }

  .page-footer {
    display: flex;
    margin-top: auto;
    padding-top: 3mm;
    align-items: end;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    color: var(--ink-tertiary);
    font-size: 0.55rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .continuation-header {
    display: flex;
    padding-bottom: 4mm;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 3px solid var(--accent);
  }

  .continuation-header > div {
    display: grid;
    gap: 0.12rem;
  }

  .continuation-header strong {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .continuation-header span {
    color: var(--ink-tertiary);
    font-size: 0.58rem;
    line-height: 1.3;
  }

  .experience--continued {
    padding-top: 3mm;
  }

  .engagement--standalone {
    padding-top: 0;
    padding-bottom: 3mm;
    border-bottom: 1px solid var(--rule);
  }

  .employer--secondary {
    padding: 3.5mm 0;
    border-bottom: 1px solid var(--rule);
  }

  .employer__results {
    margin-top: 0.55rem;
  }

  .codeo-roles {
    display: grid;
    margin-top: 0.55rem;
  }

  .codeo-role {
    break-inside: avoid;
  }

  .codeo-role + .codeo-role {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
  }

  .codeo-role__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .codeo-role__header h4 {
    margin: 0;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .codeo-role__header time {
    flex: none;
    color: var(--ink);
    font-size: 0.57rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    white-space: nowrap;
  }

  .codeo-role .employer__results {
    margin-top: 0.4rem;
  }

  code {
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
  }

  .education-section {
    padding-top: 3.5mm;
  }

  .education-entry {
    display: flex;
    padding: 3mm 0 3.4mm;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .education-entry h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .education-entry p,
  .education-entry time {
    margin: 0.12rem 0 0;
    color: var(--ink-secondary);
    font-size: 0.62rem;
    line-height: 1.4;
  }

  .education-entry time {
    flex: none;
    margin-top: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .projects-section {
    padding-top: 3.5mm;
  }

  .project-list {
    border-bottom: 1px solid var(--rule);
  }

  .project {
    padding-top: 2.8mm;
    padding-bottom: 2.8mm;
